#!/usr/bin/env python3
"""Guarded restart for the single Linux/supervisord Hermes gateway.

Uses the gateway_state.json and quiet drain marker contracts at the Hermes pin.
Never imports Hermes, reads credentials, or sends a client notification.
"""
from __future__ import annotations

import fcntl
import json
import os
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.environ.get("HERMES_HOME", "/root/.hermes"))
STATE = Path("/var/lib/orgo")
WAIT = 30.0


class Refused(RuntimeError):
    pass


@dataclass(frozen=True)
class Process:
    pid: int
    start: int
    group: int


def process(pid: int) -> Process | None:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return Process(pid, int(fields[19]), int(fields[2]))
    except FileNotFoundError:
        return None


def gateways() -> list[Process]:
    found = subprocess.run(["pgrep", "-f", "[h]ermes gateway run"], capture_output=True, text=True)
    if found.returncode not in (0, 1):
        raise Refused("gateway process scan failed")
    result = []
    for raw in found.stdout.split():
        pid = int(raw)
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().decode().split("\0")
        except FileNotFoundError:
            continue
        # Exclude flock's parent command and shells containing this command as text.
        if not any(Path(argv[i]).name == "hermes" and argv[i + 1:i + 3] == ["gateway", "run"]
                   for i in range(min(2, len(argv)))) or Path(argv[0]).name == "flock":
            continue
        entry = process(pid)
        if entry:
            result.append(entry)
    return result


def runtime(expected: Process, *, idle: bool, state: str = "running") -> None:
    try:
        body = json.loads((HOME / "gateway_state.json").read_text())
    except (OSError, ValueError):
        raise Refused("gateway activity is unknown; no stop performed") from None
    if not isinstance(body, dict) or body.get("pid") != expected.pid or body.get("start_time") != expected.start:
        raise Refused("gateway status does not identify the running process")
    active = body.get("active_agents")
    if type(active) is not int or active < 0 or body.get("gateway_state") != state:
        raise Refused("gateway activity/state is unknown; no stop performed")
    if idle and active:
        raise Refused("agent turn active; retry after the client is idle")


def supervisor(*args: str) -> str:
    reply = subprocess.run(["supervisorctl", *args], capture_output=True, text=True, timeout=WAIT + 10)
    # Supervisor uses exit 7 AND stdout "0" for a known stopped process.
    stopped_pid = args == ("pid", "hermes-gateway") and reply.returncode == 7 and reply.stdout.strip() == "0"
    if reply.returncode and not stopped_pid:
        raise Refused(f"supervisor {' '.join(args)} failed; inspect supervisor locally")
    return reply.stdout.strip()


def wait_for(check, message: str) -> None:
    deadline = time.monotonic() + WAIT
    while time.monotonic() < deadline:
        if check():
            return
        time.sleep(0.1)
    raise Refused(message)


def signal_old(old: Process, sig: int) -> None:
    if process(old.pid) != old:
        return
    if old.group <= 1 or old.group == os.getpgrp():
        raise Refused("unsafe gateway process group; manual investigation required")
    try:
        os.killpg(old.group, sig)
    except ProcessLookupError:
        pass


def stop_old(old: Process) -> None:
    supervisor("stop", "hermes-gateway")
    if process(old.pid) != old:
        return
    # Recovers an orphan left by the previous flock-as-parent unit.
    signal_old(old, signal.SIGTERM)
    try:
        wait_for(lambda: process(old.pid) != old, "old gateway did not exit after TERM")
    except Refused:
        print("gateway did not exit after TERM; using KILL on its verified process group", file=sys.stderr)
        signal_old(old, signal.SIGKILL)
        wait_for(lambda: process(old.pid) != old, "old gateway survived KILL; start refused")


def restart() -> None:
    old_pids = gateways()
    if len(old_pids) > 1:
        raise Refused("multiple gateways found; activity cannot be verified safely")
    marker = HOME / ".drain_request.json"
    marked = False
    try:
        if old_pids:
            old = old_pids[0]
            runtime(old, idle=True)
            # Acknowledged drain closes the idle-check / new-message race. Never
            # overwrite another operator's marker; suppress the home-channel notice.
            with marker.open("x") as stream:
                marked = True
                json.dump({"action": "drain", "principal": "feina-gateway-restart",
                           "requested_at": datetime.now(timezone.utc).isoformat(),
                           "suppress_notification": True}, stream)
            def drained():
                if gateways() != old_pids:
                    raise Refused("gateway identity changed during idle check")
                try:
                    runtime(old, idle=True, state="draining")
                    return True
                except Refused:
                    runtime(old, idle=True)
                    return False
            wait_for(drained, "gateway did not acknowledge quiet drain; no stop performed")
            stop_old(old)
        if gateways():
            raise Refused("old gateway remains; start refused")
        if marked:
            marker.unlink()
            marked = False
        # Bootstrap may have hardened the unit on disk. Reload only AFTER the
        # verified stop; update can autostart a changed/new program.
        supervisor("reread")
        supervisor("update", "hermes-gateway")
        if supervisor("pid", "hermes-gateway") == "0":
            supervisor("start", "hermes-gateway")
        def ready():
            current = gateways()
            if len(current) > 1:
                raise Refused("duplicate gateways after start; manual investigation required")
            if not current:
                return False
            new = current[0]
            if new in old_pids:
                raise Refused("gateway PID did not change")
            if supervisor("pid", "hermes-gateway") != str(new.pid):
                return False
            try:
                runtime(new, idle=False)
            except Refused:
                return False
            return True
        wait_for(ready, "new gateway did not become the sole supervised running process")
        print(f"gateway restarted: {old_pids[0].pid if old_pids else 'stopped'} -> {gateways()[0].pid}")
    finally:
        if marked:
            marker.unlink()


def main() -> int:
    if sys.argv[1:]:
        print("usage: feina-gateway-restart (operator only; requires approved live step)", file=sys.stderr)
        return 2
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with (STATE / "hermes-gateway-restart.lock").open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Refused("another gateway restart is in progress") from None
            restart()
    except (Refused, OSError, ValueError, subprocess.SubprocessError) as exc:
        # Do not print file contents, subprocess output, or credential-bearing config.
        print(f"gateway restart refused: {exc if isinstance(exc, Refused) else type(exc).__name__}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
